# EditorConfig — one whitespace contract for both stacks so the PHP vs Python
# diff stays honest (no formatting noise polluting the comparison).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP / Laravel follows PSR-12: 4-space indent (the default above).

# Python follows PEP 8 / ruff: 4-space indent (the default above).

[*.{yml,yaml,json}]
indent_size = 2

[*.{js,ts,vue,blade.php}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Markdown can use trailing spaces for hard line breaks.
trim_trailing_whitespace = false
