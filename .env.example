# ─────────────────────────────────────────────────────────────────────────────
# RAG Duel — environment template.  Copy to .env and fill in.  Never commit .env.
#
# Phase 0 note: this is the documented secret/config surface. Individual values
# are wired up in later phases (DB in Phase 1, provider keys in Phase 3). The
# locked, fairness-critical model parameters do NOT live here — they live in
# infra/contract.env (CONTRACT-01) so both engines read one source of truth.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared Postgres + pgvector (Phase 1: INFRA-01/04/05) ─────────────────────
# Local default matches docker-compose (INFRA-01). In prod these point at Supabase.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ragduel
POSTGRES_USER=ragduel
POSTGRES_PASSWORD=ragduel
# Convenience DSN for the Python service (INFRA-05):
DATABASE_URL=postgresql://ragduel:ragduel@127.0.0.1:5432/ragduel

# ── Provider keys (Phase 3) ──────────────────────────────────────────────────
# Gemini (Google AI Studio) is the chosen provider for BOTH chat and embeddings.
# CONTRACT-04: the human supplies this key — do not invent a placeholder value.
# Keep billing DISABLED / hard-capped per CONTRACT-06.
GEMINI_API_KEY=

# Optional fallback (CONTRACT-05): Groq, used on Gemini 429/5xx/timeout.
# Same fallback order in both engines. Safe to leave blank until you add it.
GROQ_API_KEY=

# ── Laravel app (Phase 1: INFRA-02; Phase 6 UI) ──────────────────────────────
APP_NAME="RAG Duel"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=
# Laravel reads the shared DB via these (mapped from the POSTGRES_* values above):
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ragduel
DB_USERNAME=ragduel
DB_PASSWORD=ragduel
QUEUE_CONNECTION=sync

# Base URL the Laravel UI uses to reach the Python (right-column) service.
PYTHON_SERVICE_URL=http://127.0.0.1:8001

# ── Python service (Phase 1: INFRA-03) ───────────────────────────────────────
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8001
