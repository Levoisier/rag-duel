# ─────────────────────────────────────────────────────────────────────────────
# RAG Duel — shared parameter contract (CONTRACT-01)
#
# Single source of truth for every parameter that MUST be identical across the
# PHP and Python engines. Both engines LOAD this file at runtime; neither may
# hardcode any of these values. If a value here changes, both engines change
# behavior with zero code edits — that property is what keeps the duel fair.
#
# Format: plain KEY=VALUE, full-line comments only (parsers in both engines
# stay trivial; no inline comments, no quoting, no interpolation).
# ─────────────────────────────────────────────────────────────────────────────

# Provider order (locked by the backlog): Gemini primary for chat + embeddings,
# Groq fallback on 429/5xx/timeout (CONTRACT-05). Same order in both engines.
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACK=groq

# Embeddings. gemini-embedding-001 natively emits 3072 dims but supports
# Matryoshka truncation to 1536/768. We lock 768 because pgvector's ANN indexes
# (HNSW/IVFFlat) refuse columns above 2000 dims — 3072 would make DB-05
# impossible — and 768 is a Google-recommended truncation point. NOTE: the API
# does NOT re-normalize truncated vectors; cosine distance is scale-invariant
# so retrieval order is unaffected, but L2-normalize before storing.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Chat LLM. Temperature 0 so both engines get comparably deterministic answers;
# a sampling delta would masquerade as an engine delta.
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Retrieval + chunking. CHUNK_SIZE / CHUNK_OVERLAP are in CHARACTERS, not
# tokens: PHP and Python count characters identically, while token counts would
# drag a tokenizer dependency into each engine and break chunker parity
# (TEST-03). token_count columns are informational estimates only.
TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# pgvector distance operator both engines must use: cosine (`<=>`).
SIMILARITY_METRIC=cosine

# Timings payload keys (CONTRACT-03): the exact set of phase-timing keys both
# engines emit on their metrics frame, in canonical order. Kept here — not
# hand-copied into each engine — so the two sides are identical by construction;
# drift is impossible when both read this one list. Units: every `*_ms` key is
# milliseconds (wall-clock via hrtime(true)/perf_counter, METRIC-01); `loc` is an
# integer line count (the DX metric). Which operation emits which subset is
# documented in docs/ARCHITECTURE.md §6 (ingest vs query).
TIMINGS_KEYS=extract_ms,chunk_ms,embed_ms,retrieve_ms,ttft_ms,total_ms,loc
